{
  "name": "@motuslabs/agent-runtime",
  "version": "0.1.0",
  "description": "Headless Claude and Codex agent drivers: explicit launch authority, owned process stop, resumable sessions and typed turn results.",
  "type": "module",
  "license": "MIT",
  "author": "MotusLabs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MotusLabs/kawai.git",
    "directory": "packages/agent-runtime"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./claude": {
      "types": "./dist/claude/index.d.ts",
      "import": "./dist/claude/index.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "import": "./dist/events.js"
    },
    "./profiles": {
      "types": "./dist/profiles/index.d.ts",
      "import": "./dist/profiles/index.js"
    },
    "./usage": {
      "types": "./dist/usage/index.d.ts",
      "import": "./dist/usage/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.289"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.289",
    "typescript": "^5.7.2"
  }
}
