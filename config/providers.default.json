{
  "zai": {
    "label": "Z.AI",
    "limitResetTimeZone": "Asia/Shanghai",
    "env": {
      "ANTHROPIC_BASE_URL": "https://api.z.ai/api/anthropic",
      "ANTHROPIC_DEFAULT_SONNET_MODEL": "glm-5.3-flash[1m]",
      "ANTHROPIC_DEFAULT_OPUS_MODEL": "glm-5.3[1m]",
      "ANTHROPIC_DEFAULT_HAIKU_MODEL": "glm-5.3-flash[1m]",
      "ANTHROPIC_DEFAULT_FABLE_MODEL": "glm-5.3[1m]",
      "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "1000000"
    },
    "models": {
      "glm": {
        "label": "GLM",
        "model": "opus"
      },
      "glm-flash": {
        "label": "GLM Flash",
        "model": "sonnet"
      }
    }
  },
  "claude": {
    "label": "Claude",
    "models": {
      "default": {
        "label": "Default"
      },
      "opus": {
        "label": "Claude Opus",
        "model": "claude-opus-5-5"
      },
      "sonnet": {
        "label": "Claude Sonnet",
        "model": "claude-sonnet-5-5"
      },
      "haiku": {
        "label": "Claude Haiku",
        "model": "claude-haiku-5-5"
      }
    }
  },
  "openrouter": {
    "label": "OpenRouter",
    "authTokenEnv": "OPENROUTER_API_KEY",
    "balanceKeyEnv": "OPENROUTER_MANAGEMENT_KEY",
    "env": {
      "ANTHROPIC_BASE_URL": "https://openrouter.ai/api",
      "ANTHROPIC_DEFAULT_OPUS_MODEL": "~anthropic/claude-opus-latest[1m]",
      "ANTHROPIC_DEFAULT_SONNET_MODEL": "~anthropic/claude-sonnet-latest[1m]",
      "ANTHROPIC_DEFAULT_HAIKU_MODEL": "~anthropic/claude-haiku-latest",
      "ANTHROPIC_DEFAULT_FABLE_MODEL": "~anthropic/claude-opus-latest[1m]"
    },
    "models": {
      "openrouter-opus": {
        "label": "OpenRouter Opus",
        "model": "opus"
      },
      "openrouter-sonnet": {
        "label": "OpenRouter Sonnet",
        "model": "sonnet"
      },
      "openrouter-haiku": {
        "label": "OpenRouter Haiku",
        "model": "haiku"
      }
    }
  }
}
