#!/bin/sh
# The commit hook (per-result-suite D1/D2): lint, typecheck, and the affected
# fast-tier tests for a source commit; lint, typecheck, and the tests whose
# @reads header matches a changed path for a docs-only commit; the full check
# (`bun run check`, cached by content) on an escape path or a message-only
# amend without a recorded pass. The full check runs at result and push
# (.githooks/pre-push). Git runs hooks from the working tree's root; the
# decision table lives in scripts/pre-commit.ts.
top=$(git rev-parse --show-toplevel) || {
  echo "pre-commit: cannot resolve the repository root; commit refused" >&2
  exit 1
}
exec bun "$top/scripts/pre-commit.ts"
