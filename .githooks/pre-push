#!/bin/sh
# The push hook (per-result-suite D4, pre-push-bun-pin): a pushed commit
# passes only with a recorded full pass for its tree under the running Bun or
# the Bun its own tree's .bun-version pins. With no such pass and a pin that
# differs from the running Bun, the push is refused at once, naming both
# Buns; no check runs. Otherwise `bun run check` must pass here with HEAD at
# that commit and a clean working tree; else the push is refused, naming the
# commit and the command. Deletions run nothing. Git runs hooks from the
# working tree's root and passes the refs on stdin, which
# scripts/pre-push.ts buffers whole before running anything.
top=$(git rev-parse --show-toplevel) || {
  echo "pre-push: cannot resolve the repository root; push refused" >&2
  exit 1
}
exec bun "$top/scripts/pre-push.ts" "$@"
