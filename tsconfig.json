{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/kawai/tsc.tsbuildinfo",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "types": ["bun-types", "vite/client", "vite-plugin-pwa/client"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@motuslabs/agent-runtime": ["packages/agent-runtime/src/index.ts"],
      "@motuslabs/agent-runtime/events": ["packages/agent-runtime/src/events.ts"],
      "@motuslabs/agent-runtime/*": ["packages/agent-runtime/src/*/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
